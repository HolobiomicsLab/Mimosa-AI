%%{init: {"theme": "base", "themeVariables": {
  "primaryColor": "#F1FBF6",
  "primaryBorderColor": "#2E8B57",
  "primaryTextColor": "#0E2A1A",
  "lineColor": "#2E5C45",
  "fontSize": "13px"
}} }%%
flowchart TB
    %% ===== inputs =====
    Run[/"workflow run<br/>state_result.json + workspace files"/]
    TaskSpec[/"task specification<br/>(user goal / benchmark row)"/]
    Lit[/"literature grounding<br/>via Perspicacite (optional)"/]

    %% ===== Layer 2: task checklist (built once per task hash) =====
    subgraph L2box["Layer 2 — task-locked checklist (built once per task_hash, cached)"]
        Builder["TaskChecklistBuilder<br/>(evaluators/task_checklist.py)"]
        Checklist["checklist items<br/>(must-haves, methodology, metrics)"]
    end
    TaskSpec --> Builder
    Lit --> Builder
    Builder --> Checklist

    %% ===== claim pipeline =====
    subgraph Pipeline["VerifierEvaluator pipeline (evaluators/verifier.py)"]
        direction TB
        Extract["extract atomic claims<br/>(checklist-driven OR narration<br/>fallback) — typ. 5-20 claims"]
        Classify{"per claim:<br/>executable in code?"}
        GenScript["generate verifier script<br/>(LLM, opens workspace files,<br/>recomputes value)"]
        AntiTaut["anti-tautology tripwires:<br/>literal/output overlap +<br/>I/O markers check"]
        Sandbox[["WorkflowRunner sandbox<br/>per-claim execution"]]
        Soft["soft LLM verdict<br/>(pass/unsure/fail<br/>→ 1.0 / 0.5 / 0.0)<br/>anchored on previews+grounding"]
        ScoreClaim["per-claim score ∈ {0, 0.5, 1}<br/>+ status (pass/fail/error)"]
    end

    Run --> Extract
    Checklist --> Extract
    Extract --> Classify
    Classify -- yes --> GenScript
    GenScript --> AntiTaut
    AntiTaut --> Sandbox
    Sandbox --> ScoreClaim
    Classify -- no --> Soft
    Soft --> ScoreClaim

    %% ===== Layer 3: independent cheat audit =====
    subgraph L3box["Layer 3 — independent cheat detector"]
        Cheat["CheatDetector<br/>reads task spec + workflow .py only<br/>(NEVER claims / evaluation output)"]
        Findings["behavioral findings → mutator<br/>mechanism findings → audit only"]
    end
    Run -. "workflow source" .-> Cheat
    TaskSpec --> Cheat
    Cheat --> Findings

    %% ===== Aggregation =====
    subgraph Aggregate["Aggregation (_aggregate)"]
        Mean["base_mean = mean(per-claim scores)"]
        Bonus["info_bonus = α·(1 − exp(−n_hard_pass / β))<br/>α=0.15, β=8 — saturating reward for thoroughness"]
        Cap["hard-fail cap (0.94):<br/>any refuted hard claim → overall ≤ cap"]
        Penalty["cheat_penalty subtracted<br/>overall_score = max(0, …)"]
    end

    ScoreClaim --> Mean
    ScoreClaim --> Bonus
    Mean --> Cap
    Bonus --> Cap
    Cap --> Penalty
    Findings -- penalty --> Penalty

    %% ===== outputs =====
    Penalty --> Overall["overall_score ∈ [0, 1]<br/>(reward) + reward_uncapped<br/>(base+bonus−cheat, no cap)"]
    Penalty --> Diag["Layer 1 — abstracted diagnosis<br/>(rubric-blind plain text)<br/>→ only signal fed back to mutator"]
    Overall -. drives .-> Loop[/"EvolutionEngine.evolve_generation()"/]
    Diag -. drives .-> Loop

    %% ===== styling =====
    classDef stage fill:#F1FBF6,stroke:#2E8B57,stroke-width:1px,color:#0E2A1A;
    classDef external fill:#FFF7E6,stroke:#A36A00,color:#202020;
    class L2box,L3box,Pipeline,Aggregate stage;
    class Run,TaskSpec,Lit external;
