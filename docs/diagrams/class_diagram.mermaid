graph TD
      A["User Goal"] --> B["EvolutionEngine<br/>evolution_engine.py"]
      B --> C["WorkflowOrchestrator<br/>orchestrator.py"]
      C --> D["WorkflowFactory<br/>workflow_factory.py<br/>(Factory base: factory.py)"]
      D --> E["LLMProvider<br/>llm_provider.py - litellm"]
      E --> F["WorkflowRunner<br/>workflow_runner.py<br/>subprocess execution"]
      G["SmolAgentFactory template<br/>sources/modules/smolagent_factory.py"] -.->|"read as text and injected into script"| D
      F --> H["SmolAgent Instances<br/>inside generated script"]
      D -->|"load_tools_code"| I["ToolManager<br/>tools_manager.py"]
      I --> J["MCP Servers<br/>0.0.0.0:5000-5200 /mcp"]
      H -.->|"runtime tool calls"| J

      %% 4-Layer Architecture
      subgraph "Meta-Orchestration Layer"
          B
          C
      end

      subgraph "Workflow Composition Layer"
          D
          E
          F
      end

      subgraph "Agent Execution Layer"
          G
          H
      end

      subgraph "Tool Primitives Layer"
          I
          J
      end

      %% Evaluation Layer
      Q["WorkflowEvaluator<br/>evaluator.py facade"]
      P["PolicyBTVerifierEvaluator<br/>policy_bt_verifier/evaluator.py"]

      B -->|"judge.evaluate verifier"| Q
      Q -->|"verifier_kind policy_bt"| P
      F -->|"execution output in workspace_dir"| P
      P -.->|"reward feeds selection"| B
      P -.->|"LLM recon and compare calls"| E

      subgraph "Evaluation Layer"
          Q
          P
      end

      %% Storage Components
      K["sources/workflows/CAMPAIGN/<br/>UUID folders: code, state_result.json,<br/>verifier logs, .policy_bt registry"]
      L["sources/memory/CAMPAIGN/<br/>UUID folders: LLM call records and cache"]
      M["sources/prompts/<br/>system prompts"]

      D -->|"save workflow files"| K
      P -->|"registry and verifier logs"| K
      E -->|"cache and call records"| L
      M -.->|"system prompt"| D

      %% External Dependencies
      N["Toolomics MCP Servers<br/>external repo, streamable HTTP"]
      O["Environment and .env<br/>OPENROUTER_API_KEY, OPENAI_API_KEY,<br/>ANTHROPIC_API_KEY, DEEPSEEK_API_KEY,<br/>ZAI_API_KEY, HF_TOKEN"]

      J --> N
      O --> E

      classDef layer1 fill:#e1f5fe
      classDef layer2 fill:#f3e5f5
      classDef layer3 fill:#e8f5e8
      classDef layer4 fill:#fff3e0
      classDef storage fill:#f5f5f5
      classDef external fill:#ffebee

      class B,C,Q,P layer1
      class D,E,F layer2
      class G,H layer3
      class I,J layer4
      class K,L,M storage
      class N,O external
