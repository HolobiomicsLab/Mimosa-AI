%%{init: {"theme": "base", "themeVariables": {
  "primaryColor": "#F5F0FF",
  "primaryBorderColor": "#6A4FB5",
  "primaryTextColor": "#1A1240",
  "lineColor": "#4F3D85",
  "fontSize": "13px"
}} }%%
flowchart TB
    %% ===== task entry =====
    Task[/"task spec<br/>(user goal / benchmark row)"/]
    Install["install task-locked checklist<br/>(Layer 2 — built once / task_hash)"]
    Task --> Install

    %% ===== initial population =====
    subgraph Init["Cold start — seed phase"]
        ResetArch["reset session archive<br/>self.selection._archive = []"]
        ColdScan["WorkflowSelector<br/>cosine sim ≥ 0.5 over disk<br/>(cross-task transfer)"]
        Seed["VariationEngine.seed_genome_prompt()<br/>or mutation prompt over best disk parent"]
    end
    Install --> ResetArch
    ResetArch --> ColdScan
    ColdScan --> Seed

    %% ===== main generation loop =====
    subgraph Loop["EvolutionEngine.evolve_generation() — depth-first recursion"]
        direction TB
        ParentDraw{{"archive populated?"}}
        DrawArch["select_parent_workflows()<br/>QD-roulette over archive<br/>÷ (1 + n_children_already)"]
        DrawDisk["cold-start fallback:<br/>similarity-filtered disk scan"]
        Decide{{"crossover_rate ≈ 0.3?"}}
        Mut["mutation_prompt()<br/>phase-aware annealing schedule<br/>SEED → ANCHOR → DECOMPOSE → ENGAGE → POLISH"]
        Cross["crossover_prompt()<br/>best-parent-first ordering<br/>rubric-blind diagnosis"]

        Orch["WorkflowOrchestrator<br/>LLM → workflow code → install deps → sandbox run"]
        State["state_result.json<br/>+ workspace artefacts"]
        Verify["3-layer verifier<br/>(see evaluation_pipeline.mermaid)<br/>→ overall_score / reward_uncapped<br/>→ abstracted diagnosis"]

        Validate["SelectionPressure.validate_survivor()<br/>relative_improvement > θ<br/>OR qd_score > admit_threshold"]
        Admit{{"_try_admit()<br/>not Pareto-dominated on<br/>(reward_uncapped, novelty)?"}}
        Archive[("session archive<br/>≤ population_size, evict min(qd_score)")]
        Reject(["admit_rejected++<br/>(telemetry only)"])
        Lineage["record_lineage()<br/>seed | mutation | crossover"]
    end

    Seed --> Orch
    ParentDraw -- yes --> DrawArch
    ParentDraw -- no --> DrawDisk
    DrawArch --> Decide
    DrawDisk --> Decide
    Decide -- "mutation" --> Mut
    Decide -- "crossover (≥2 parents)" --> Cross
    Mut --> Orch
    Cross --> Orch
    Orch --> State
    State --> Verify
    Verify --> Validate
    Validate --> Admit
    Admit -- yes --> Archive
    Admit -- no --> Reject
    Archive --> Lineage
    Reject --> Lineage
    Lineage --> ParentDraw

    %% ===== termination =====
    subgraph Term["Termination & restore"]
        Score{{"overall_score &gt;<br/>learned_score_threshold (0.95)?"}}
        Depth{{"iteration ≥ max_depth?<br/>(default 25)"}}
        Restore["WorkspaceManager.restore_best()<br/>copy best run's workspace snapshot"]
        Plots["save reward_progress.png<br/>+ evolution_tree.png"]
        Notify["Pushover notification<br/>(best uuid + score)"]
    end

    Validate --> Score
    Score -- "yes (learn mode)" --> Restore
    Score -- "no" --> Depth
    Depth -- "yes" --> Restore
    Depth -- "no" --> ParentDraw
    Restore --> Plots --> Notify

    %% ===== sidebars =====
    subgraph QD["Quality-Diversity machinery"]
        BD["behaviour descriptor<br/>extract_code_features() →<br/>[n_agents, n_edges, n_branches,<br/> prompt_chars] / SCALES"]
        Nov["k-NN novelty<br/>(k=25, against archive)"]
        QDscore["qd_score = (1-w)·quality_norm +<br/>w·novelty_norm  (w=0.4)<br/>quality from reward_uncapped"]
    end
    State -. AST .-> BD
    Archive -. distances .-> Nov
    BD --> QDscore
    Nov --> QDscore
    QDscore -.-> Validate
    QDscore -.-> Archive

    classDef stage fill:#F5F0FF,stroke:#6A4FB5,stroke-width:1px,color:#1A1240;
    classDef store fill:#EAF2FF,stroke:#3D6BBF,color:#102040;
    classDef warn fill:#FFE5E5,stroke:#B53C3C,color:#3a0a0a;
    class Init,Loop,Term,QD stage;
    class Archive store;
    class Reject warn;
