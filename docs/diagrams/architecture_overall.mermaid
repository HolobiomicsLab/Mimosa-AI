%%{init: {"theme": "base", "themeVariables": {
  "primaryColor": "#FFF7E6",
  "primaryBorderColor": "#A36A00",
  "primaryTextColor": "#202020",
  "lineColor": "#7A5C2E",
  "fontSize": "14px"
}} }%%
flowchart TB
    %% =============== entry ===================================================
    User([User CLI<br/>main.py])

    subgraph L0["Layer 0 — Planning (optional)"]
        Planner["Planner<br/>(sources/core/planner.py)<br/>goal → multi-step task list"]
    end

    subgraph L1["Layer 1 — Tool Discovery"]
        Tools["ToolManager / MCP<br/>(sources/core/tools_manager.py)<br/>scans Toolomics + local net"]
        Persp["Perspicacite client<br/>(literature grounding)"]
    end

    subgraph L2["Layer 2 — Meta-orchestration (EvolutionEngine)"]
        direction TB
        ParentSel["WorkflowSelector<br/>archive draw / disk scan<br/>(workflow_selection.py)"]
        Selection["SelectionPressure (QD)<br/>archive + admit gate<br/>(selection.py)"]
        Variation["VariationEngine<br/>seed / mutation / crossover<br/>(variation_engine.py)"]
        Orch["WorkflowOrchestrator<br/>(orchestrator.py)"]
        Factory["WorkflowFactory<br/>SingleAgentFactory<br/>(factory.py)"]
        Lineage["lineage.py<br/>persist parent edges"]
    end

    subgraph L3["Layer 3 — Agent execution"]
        Runner["WorkflowRunner<br/>sandboxed Python<br/>(workflow_runner.py)"]
        Smol["SmolAgent runtime<br/>(modules/smolagent_factory.py)"]
        State["state_result.json<br/>+ workspace artefacts"]
    end

    subgraph L4["Layer 4 — Judge / Evaluation"]
        direction TB
        Eval["WorkflowEvaluator<br/>(evaluators/evaluator.py)"]
        Verifier["VerifierEvaluator<br/>3-layer defense<br/>(evaluators/verifier.py)"]
        Checklist["TaskChecklist<br/>(task_checklist.py)"]
        Cheat["CheatDetector<br/>(verifier internal Layer 3)"]
        Generic["GenericEvaluator<br/>(generic.py)"]
        Scenario["ScenarioEvaluator<br/>(scenario.py)"]
    end

    subgraph Storage["Persistent storage"]
        WFs[("sources/workflows/&lt;uuid&gt;/<br/>genotype.py · state_result.json<br/>memory/ · lineage_*.json")]
        Capsule[("runs_capsule/<br/>final artefacts + plots")]
        Cache[("sources/memory/<br/>llm cache · task checklists")]
    end

    %% =============== flows ===================================================
    User -->|--goal| Planner
    User -->|--task / --science_agent_bench| L2
    Planner --> L2

    Tools --> Factory
    Persp --> Orch

    ParentSel -->|Population members| Variation
    Selection <-->|admit / draw| ParentSel
    Variation --> Orch
    Orch --> Factory
    Factory --> Runner
    Runner --> Smol
    Smol --> State

    State --> Eval
    Eval --> Verifier
    Verifier --> Checklist
    Verifier --> Cheat
    Eval --> Generic
    Eval --> Scenario

    Eval -- reward --> Selection
    Selection --> Lineage
    Lineage --> WFs
    State --> WFs
    WFs --> Capsule
    Eval -.cache.-> Cache

    %% =============== styling =================================================
    classDef layer fill:#FFF7E6,stroke:#A36A00,stroke-width:1px;
    classDef store fill:#EAF2FF,stroke:#3D6BBF,color:#102040;
    class L0,L1,L2,L3,L4 layer;
    class WFs,Capsule,Cache store;
